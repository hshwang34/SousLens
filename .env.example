# Copy to backend/.env. Never commit real values.
DATABASE_URL=postgresql+asyncpg://souslens:souslens@localhost:5433/souslens
TEST_DATABASE_URL=postgresql+asyncpg://souslens:souslens@localhost:5433/souslens_test
JWT_SECRET=change-me-dev-only-32-bytes-minimum-please
AUTH_MODE=dev                 # dev | apple (Slice 7)
AI_PROVIDER=mock              # mock | gemini (Slice 4+)
GEMINI_API_KEY=               # backend only; never on the phone; paid tier only (DECISIONS #19)
# Per-capability models (DECISIONS #19); defaults shown. Re-verify ids when changing them.
# GEMINI_MODEL_COACH=gemini-3.8-flash
# GEMINI_MODEL_INSPECT=gemini-3.8-flash
# GEMINI_MODEL_SUBSTITUTION=gemini-3.8-flash
# GEMINI_MODEL_PANTRY=gemini-3.5-flash-lite
# GEMINI_MODEL_VIDEO=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=18   # whole-call deadline incl. retries (inside the 20 s endpoint budget)
# Cost guard (USD, UTC day / UTC month). Over a cap answers come from the labelled demo path.
# AI_USER_DAILY_CAP_USD=0.25
# AI_MONTH_SOFT_CAP_USD=15    # video extraction off
# AI_MONTH_HARD_CAP_USD=22    # everything falls back to demo answers
MEDIA_ROOT=./media            # local signed-URL store for dev
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
